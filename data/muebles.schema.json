{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planograma muebles",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "display_name",
      "image",
      "zones"
    ],
    "properties": {
      "display_name": {
        "type": "string"
      },
      "image": {
        "type": "string"
      },
      "zones": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "poly_norm": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "bbox_norm": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  }
}